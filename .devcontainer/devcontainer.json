{
  "name": "go-intermediate",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/go-intermediate",
  "forwardPorts": [8080, 3306],
  "postCreateCommand": "go version && sudo apt-get update && sudo apt-get install -y default-mysql-client",
  "customizations": {
    "vscode": {
      "extensions": ["golang.Go"],
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true
      }
    }
  }
}
